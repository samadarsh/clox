    m94() { return 94 + 0.25 + 0.25; }
    m95() { return 95 + 0.25 + 0.25; }
    m96() { return 96 + 0.25 + 0.25; }
    m97() { return 97 + 0.25 + 0.25; }
    m98() { return 98 + 0.25 + 0.25; }
    m99() { return 99 + 0.25 + 0.25; }
    m100() { return 100 + 0.25 + 0.25; }
    m101() { return 101 + 0.25 + 0.25; }
    m102() { return 102 + 0.25 + 0.25; }
    m103() { return 103 + 0.25 + 0.25; }
    m104() { return 104 + 0.25 + 0.25; }
    m105() { return 105 + 0.25 + 0.25; }
    m106() { return 106 + 0.25 + 0.25; }
    m107() { return 107 + 0.25 + 0.25; }
    m108() { return 108 + 0.25 + 0.25; }
    m109() { return 109 + 0.25 + 0.25; }
    m110() { return 110 + 0.25 + 0.25; }
    m111() { return 111 + 0.25 + 0.25; }
    m112() { return 112 + 0.25 + 0.25; }
    m113() { return 113 + 0.25 + 0.25; }
    m114() { return 114 + 0.25 + 0.25; }
    m115() { return 115 + 0.25 + 0.25; }
    m116() { return 116 + 0.25 + 0.25; }
    m117() { return 117 + 0.25 + 0.25; }
    m118() { return 118 + 0.25 + 0.25; }
