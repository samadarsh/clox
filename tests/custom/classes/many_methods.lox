// A class's method names and method functions are constants in the chunk
// AROUND the class, and one chunk holds at most 256 constants (OP_CONSTANT
// has a one-byte operand). Inside make(), the class uses 1 constant for its
// name and 2 per method, so 127 methods use 255: the largest that fits.
//
// Each method body is its own function with its own chunk, so constants
// inside methods don't count. Every method here has 3 constants of its own:
// 381 more, 636 in the whole class.
fun make() {
  class Many {
    m0() { return 0 + 0.25 + 0.25; }
    m1() { return 1 + 0.25 + 0.25; }
    m2() { return 2 + 0.25 + 0.25; }
    m3() { return 3 + 0.25 + 0.25; }
    m4() { return 4 + 0.25 + 0.25; }
    m5() { return 5 + 0.25 + 0.25; }
    m6() { return 6 + 0.25 + 0.25; }
    m7() { return 7 + 0.25 + 0.25; }
    m8() { return 8 + 0.25 + 0.25; }
    m9() { return 9 + 0.25 + 0.25; }
    m10() { return 10 + 0.25 + 0.25; }
    m11() { return 11 + 0.25 + 0.25; }
    m12() { return 12 + 0.25 + 0.25; }
    m13() { return 13 + 0.25 + 0.25; }
    m14() { return 14 + 0.25 + 0.25; }
    m15() { return 15 + 0.25 + 0.25; }
    m16() { return 16 + 0.25 + 0.25; }
    m17() { return 17 + 0.25 + 0.25; }
    m18() { return 18 + 0.25 + 0.25; }
    m19() { return 19 + 0.25 + 0.25; }
    m20() { return 20 + 0.25 + 0.25; }
    m21() { return 21 + 0.25 + 0.25; }
    m22() { return 22 + 0.25 + 0.25; }
    m23() { return 23 + 0.25 + 0.25; }
    m24() { return 24 + 0.25 + 0.25; }
    m25() { return 25 + 0.25 + 0.25; }
    m26() { return 26 + 0.25 + 0.25; }
    m27() { return 27 + 0.25 + 0.25; }
    m28() { return 28 + 0.25 + 0.25; }
    m29() { return 29 + 0.25 + 0.25; }
    m30() { return 30 + 0.25 + 0.25; }
    m31() { return 31 + 0.25 + 0.25; }
    m32() { return 32 + 0.25 + 0.25; }
    m33() { return 33 + 0.25 + 0.25; }
    m34() { return 34 + 0.25 + 0.25; }
    m35() { return 35 + 0.25 + 0.25; }
    m36() { return 36 + 0.25 + 0.25; }
    m37() { return 37 + 0.25 + 0.25; }
    m38() { return 38 + 0.25 + 0.25; }
    m39() { return 39 + 0.25 + 0.25; }
    m40() { return 40 + 0.25 + 0.25; }
    m41() { return 41 + 0.25 + 0.25; }
    m42() { return 42 + 0.25 + 0.25; }
    m43() { return 43 + 0.25 + 0.25; }
    m44() { return 44 + 0.25 + 0.25; }
    m45() { return 45 + 0.25 + 0.25; }
    m46() { return 46 + 0.25 + 0.25; }
    m47() { return 47 + 0.25 + 0.25; }
    m48() { return 48 + 0.25 + 0.25; }
    m49() { return 49 + 0.25 + 0.25; }
    m50() { return 50 + 0.25 + 0.25; }
    m51() { return 51 + 0.25 + 0.25; }
    m52() { return 52 + 0.25 + 0.25; }
    m53() { return 53 + 0.25 + 0.25; }
    m54() { return 54 + 0.25 + 0.25; }
    m55() { return 55 + 0.25 + 0.25; }
    m56() { return 56 + 0.25 + 0.25; }
    m57() { return 57 + 0.25 + 0.25; }
    m58() { return 58 + 0.25 + 0.25; }
    m59() { return 59 + 0.25 + 0.25; }
    m60() { return 60 + 0.25 + 0.25; }
    m61() { return 61 + 0.25 + 0.25; }
    m62() { return 62 + 0.25 + 0.25; }
    m63() { return 63 + 0.25 + 0.25; }
    m64() { return 64 + 0.25 + 0.25; }
    m65() { return 65 + 0.25 + 0.25; }
    m66() { return 66 + 0.25 + 0.25; }
    m67() { return 67 + 0.25 + 0.25; }
    m68() { return 68 + 0.25 + 0.25; }
    m69() { return 69 + 0.25 + 0.25; }
    m70() { return 70 + 0.25 + 0.25; }
