    m122() { return 122 + 0.25 + 0.25; }
    m123() { return 123 + 0.25 + 0.25; }
    m124() { return 124 + 0.25 + 0.25; }
    m125() { return 125 + 0.25 + 0.25; }
    m126() { return 126 + 0.25 + 0.25; }
  }
  return Many;
}

var many = make()();
print many.m0(); // expect: 0.5
print many.m64(); // expect: 64.5
print many.m126(); // expect: 126.5

// Every method is really there.
print many.m1() + many.m2() + many.m125(); // expect: 129.5
