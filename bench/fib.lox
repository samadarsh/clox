// Recursive Fibonacci: a benchmark for function calls. fib(30) makes
// 2,692,537 calls. Run with the release build: ./build/release/clox bench/fib.lox
fun fib(n) {
  if (n < 2) return n;
  return fib(n - 2) + fib(n - 1);
}

var start = clock();
print fib(30);
print "seconds:";
print clock() - start;
